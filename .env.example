NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Bases distintas por entorno (requisito del proyecto)
MONGODB_URI_DEV=mongodb://127.0.0.1:27017/apicenar_dev
MONGODB_URI_QA=mongodb://127.0.0.1:27017/apicenar_qa

# JWT
JWT_SECRET=cambia_este_secreto_jwt_en_equipo
JWT_EXPIRES_IN=8h

# Correo — Mailtrap Sandbox (Email Testing)
# Los mails se ven en https://mailtrap.io → My Sandbox (no llegan a Gmail real)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=tu_username_mailtrap
EMAIL_PASS=tu_password_mailtrap
EMAIL_FROM=ApiCenar <noreply@apicenar.local>
